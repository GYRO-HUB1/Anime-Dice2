local function getTranslation(lang)
    if lang == "zh" then
        local full = nil
        pcall(function() full = LocalizationService.SystemLocaleId end)
        if full and (string.find(string.lower(full), "tw") or string.find(string.lower(full), "hk")) then
            return TRANSLATIONS["zh-tw"]
        end
        return TRANSLATIONS["zh-cn"]
    end
    return TRANSLATIONS[lang] or TRANSLATIONS.en
end

