-- ========== LÓGICA DE VERIFICACIÓN ==========
local verifying = false

local function setStatus(text, color)
    statusLabel.Text = text
    statusLabel.TextColor3 = color or Color3.fromRGB(200, 210, 235)
end

local function unlockScript()
    local exitTween = TweenService:Create(main, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 0, 0, 0),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        BackgroundTransparency = 1
    })
    exitTween:Play()
    TweenService:Create(backdrop, TweenInfo.new(0.35), {BackgroundTransparency = 1}):Play()
    exitTween.Completed:Wait()
    gui:Destroy()
    loadstring(game:HttpGet(SCRIPT_URL))()
end

local function verifyMembership()
    if verifying then return end
    verifying = true

    confirmBtn.Active = false
    confirmBtn.Text = T.checking
    setStatus("", Color3.fromRGB(200, 210, 235))

    local ok, result = pcall(function()
        return LocalPlayer:IsInGroupAsync(GROUP_ID)
    end)

    if not ok then
        confirmBtn.Text = T.confirm
        confirmBtn.Active = true
        setStatus(T.error, Color3.fromRGB(255, 180, 100))
        verifying = false
        return
    end

    if result == true then
        confirmBtn.Text = T.success
        confirmBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 100)
        if confirmGradient then confirmGradient:Destroy() end
        setStatus(T.success, Color3.fromRGB(120, 255, 180))
        task.wait(1)
        unlockScript()
    else
        confirmBtn.Text = T.confirm
        confirmBtn.Active = true
        setStatus(T.fail, Color3.fromRGB(255, 100, 100))
        local originalPos = main.Position
        for i = 1, 3 do
            TweenService:Create(main, TweenInfo.new(0.06), {Position = originalPos + UDim2.new(0, 8, 0, 0)}):Play()
            task.wait(0.06)
            TweenService:Create(main, TweenInfo.new(0.06), {Position = originalPos - UDim2.new(0, 8, 0, 0)}):Play()
            task.wait(0.06)
        end
        TweenService:Create(main, TweenInfo.new(0.06), {Position = originalPos}):Play()
        verifying = false
    end
end

local function copyLink()
    local ok = pcall(function() setclipboard(GROUP_COPY_URL) end)
    if ok and setclipboard then
        copyBtn.Text = T.copied
        copyBtn.TextColor3 = Color3.fromRGB(120, 255, 180)
        task.wait(2)
        copyBtn.Text = T.copy
        copyBtn.TextColor3 = Color3.fromRGB(220, 225, 240)
    else
        copyBtn.Text = T.copyManual
        copyBtn.TextColor3 = Color3.fromRGB(255, 200, 100)
        task.wait(2)
        copyBtn.Text = T.copy
        copyBtn.TextColor3 = Color3.fromRGB(220, 225, 240)
    end
end

